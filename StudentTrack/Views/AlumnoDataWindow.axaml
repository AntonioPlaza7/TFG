<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StudentTrack.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="250"
        x:Class="StudentTrack.Views.AlumnoDataWindow"
        x:DataType="vm:AlumnoDataWindowViewModel"
        Title="Nuevo Alumno" Width="300" Height="250">
    
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Nombre del alumno: "/>
        <TextBlock Text="{Binding Alumno.Nombre}"/>
        <TextBlock Text="Apellidos del alumno: "/>
        <TextBlock Text="{Binding Alumno.Apellidos}"/>
        <TextBlock Text="Email del alumno: "/>
        <TextBlock Text="{Binding Alumno.Email}"/>
        <TextBlock Text="Telefono del alumno: "/>
        <TextBlock Text="{Binding Alumno.Telefono}"/>
    </StackPanel>

</Window>
