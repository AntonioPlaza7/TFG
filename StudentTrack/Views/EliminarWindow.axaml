<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StudentTrack.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="100"
        x:Class="StudentTrack.Views.EliminarWindow"
        x:DataType="vm:EliminarWindowViewModel"
        Title="Eliminar" Width="500" Height="100">
    
        <StackPanel Margin="20" Spacing="10">
            <TextBlock Text="{Binding Texto}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Si" Click="OnEliminarClick"/>
                <TextBlock HorizontalAlignment="Stretch" />
                <Button Content="No" Click="OnCancelarClick"/>
            </StackPanel>
        </StackPanel>

</Window>
